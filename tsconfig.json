{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".cache/tsc/root.tsbuildinfo"
  },
  "include": [
    "packages/*/src/**/*.ts",
    "tools/**/*.ts",
    "apps/client/src/**/*.test.ts",
    "apps/client/build.ts",
    "apps/client/*.test.ts"
  ]
}
