// The prayer-time bands the clock reads in (GDD §3.2), one fixed row per Masehi month.
//
// Deliberately a table, not astronomy: computing times from latitude and date would cost
// packages/sim its purity and determinism for precision the game never uses (ADR-0009).
// Each row is a rounded, typical time for the middle of the month at Purworejo (WIB). The
// rows were re-keyed from the earlier per-mangsa table (M1-01, read off published jadwal
// sholat for nearby Yogyakarta) by taking the mangsa each month's 15th fell in, so May and
// June share a row, as do November and December.
//
// verified: false — against a Kemenag table for Purworejo itself.
//
// A band runs from its start until the next band starts; after `isya` it wraps past
// midnight to the next `subuh`. `dhuha` starts at sunrise (terbit).
// ⚠️ Display only: bands never gate, score or require anything (CULTURE_GUIDE §3).
{
  verified: false,
  bands: ['subuh', 'dhuha', 'dzuhur', 'ashar', 'maghrib', 'isya'],
  byMonth: [
    // month   subuh    dhuha    dzuhur   ashar    maghrib  isya
    { month: 'jan', starts: ['04:04', '05:28', '11:46', '15:12', '18:05', '19:20'] },
    { month: 'feb', starts: ['04:20', '05:40', '11:56', '15:15', '18:05', '19:17'] },
    { month: 'mar', starts: ['04:24', '05:42', '11:51', '15:03', '17:57', '19:07'] },
    { month: 'apr', starts: ['04:23', '05:41', '11:45', '14:58', '17:48', '18:58'] },
    { month: 'may', starts: ['04:31', '05:52', '11:43', '15:05', '17:34', '18:48'] },
    { month: 'jun', starts: ['04:31', '05:52', '11:43', '15:05', '17:34', '18:48'] },
    { month: 'jul', starts: ['04:35', '05:55', '11:48', '15:09', '17:37', '18:51'] },
    { month: 'aug', starts: ['04:32', '05:50', '11:46', '15:07', '17:40', '18:52'] },
    { month: 'sep', starts: ['04:22', '05:40', '11:40', '15:00', '17:41', '18:51'] },
    { month: 'oct', starts: ['03:58', '05:18', '11:28', '14:45', '17:40', '18:53'] },
    { month: 'nov', starts: ['03:52', '05:15', '11:32', '14:57', '17:50', '19:05'] },
    { month: 'dec', starts: ['03:52', '05:15', '11:32', '14:57', '17:50', '19:05'] },
  ],
}
