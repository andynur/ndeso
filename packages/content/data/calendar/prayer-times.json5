// The prayer-time bands the clock reads in (GDD §3.2), one fixed row per mangsa.
//
// Deliberately a table, not astronomy: computing times from latitude and date
// would cost packages/sim its purity and determinism for precision the game
// never uses (the ADR-0007 argument). Each row is a rounded, typical time for
// the middle of that mangsa's real date range at Purworejo (WIB), read off
// published jadwal sholat for nearby Yogyakarta.
//
// verified: false — against a Kemenag table for Purworejo itself.
//
// A band runs from its start until the next band starts; after `isya` it wraps
// past midnight to the next `subuh`. `dhuha` starts at sunrise (terbit).
// ⚠️ Display only: bands never gate, score or require anything (CULTURE_GUIDE §3).
{
  verified: false,
  bands: ['subuh', 'dhuha', 'dzuhur', 'ashar', 'maghrib', 'isya'],
  byMangsa: [
    // mangsa         subuh    dhuha    dzuhur   ashar    maghrib  isya
    { mangsa: 'kasa',     starts: ['04:35', '05:55', '11:48', '15:09', '17:37', '18:51'] },
    { mangsa: 'karo',     starts: ['04:32', '05:50', '11:46', '15:07', '17:40', '18:52'] },
    { mangsa: 'katelu',   starts: ['04:22', '05:40', '11:40', '15:00', '17:41', '18:51'] },
    { mangsa: 'kapat',    starts: ['04:08', '05:27', '11:33', '14:48', '17:40', '18:51'] },
    { mangsa: 'kalima',   starts: ['03:58', '05:18', '11:28', '14:45', '17:40', '18:53'] },
    { mangsa: 'kanem',    starts: ['03:52', '05:15', '11:32', '14:57', '17:50', '19:05'] },
    { mangsa: 'kapitu',   starts: ['04:04', '05:28', '11:46', '15:12', '18:05', '19:20'] },
    { mangsa: 'kawolu',   starts: ['04:20', '05:40', '11:56', '15:15', '18:05', '19:17'] },
    { mangsa: 'kasanga',  starts: ['04:24', '05:42', '11:51', '15:03', '17:57', '19:07'] },
    { mangsa: 'kasadasa', starts: ['04:23', '05:41', '11:45', '14:58', '17:48', '18:58'] },
