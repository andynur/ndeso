{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000"
  },
  "permissions": {
    "allow": [
      "Bash(bun install:*)",
      "Bash(bun run:*)",
      "Bash(bun test:*)",
      "Bash(bun tools/:*)",
      "Bash(bunx biome:*)",
      "Bash(bunx tsc:*)",
      "Bash(awk:*)",
      "Bash(cat:*)",
      "Bash(comm:*)",
      "Bash(cut:*)",
      "Bash(diff:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(sed -n:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(tr:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git checkout -B:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(bun add:*)",
      "Bash(bun remove:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./bun.lock)",
      "Read(./dist/**)",
      "Read(./assets/**)",
      "Read(./assets-src/**)",
      "Read(**/node_modules/**)",
      "Read(**/*.glb)",
      "Read(**/*.ktx2)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm publish:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session-start.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v bun >/dev/null 2>&1; then bun \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/post-edit.ts; fi",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
