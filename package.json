{
  "name": "ndeso",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "bun@1.4.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun tools/dev.ts",
    "build": "bun tools/todo.ts M0-07 'production build'",
    "check": "bun run check:types && bun run check:lint && bun run check:deps && bun run check:i18n && bun run check:content && bun run test",
    "check:types": "tsc -b --noEmit && tsc -b apps/client --noEmit",
    "check:lint": "biome check .",
    "check:deps": "bun tools/check-deps.ts",
    "check:i18n": "bun tools/i18n/check.ts",
    "check:content": "bun tools/todo.ts M2-01 'content schema check'",
    "check:size": "bun tools/todo.ts M0-07 'size budget report'",
    "gen:i18n": "bun tools/i18n/gen-types.ts",
    "smoke": "bun tools/todo.ts M2-19 'Bun.WebView smoke test'",
    "test": "bun test",
    "fmt": "biome check --write .",
    "ci": "bun run check && bun run build && bun run check:size && bun run smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@ndeso/shared": "workspace:*",
    "@types/three": "~0.186.0",
    "bun-types": "1.4.1",
    "typescript": "5.9.3"
  }
}
